eight="100" as="geometry"/></mxCell><mxCell id="aug" value="&lt;b&gt;PermissionAugmentor&lt;/b&gt;&lt;br&gt;+ PermissionIdentitySupplier&lt;br&gt;monta a SecurityIdentity: CLIENT/INTERNAL, SUPER_ADMIN e uma role por permissão" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="L0"><mxGeometry x="700" y="20" width="240" height="100" as="geometry"/></mxCell><mxCell id="authfail" value="&lt;b&gt;AuthenticationFailureHandler&lt;/b&gt;&lt;br&gt;token inválido/expirado → 401 (mesma mensagem sempre)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="L0"><mxGeometry x="160" y="20" width="240" height="100" as="geometry"/></mxCell><mxCell id="resources" value="&lt;b&gt;11 Resources JAX-RS&lt;/b&gt;&lt;br&gt;Auth · User · Internal · InternalRole · Product · Size · Ingredient · Combo · Promotion · PromotionType · Order" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="L1"><mxGeometry x="160" y="20" width="240" height="110" as="geometry"/></mxCell><mxCell id="perms" value="&lt;b&gt;resource.security.Permissions&lt;/b&gt;&lt;br&gt;@PermitAll · @Authenticated · @RolesAllowed(MANAGE_X)&lt;br&gt;sem anotação = negado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="L1"><mxGeometry x="970" y="20" width="240" height="110" as="geometry"/></mxCell><mxCell id="pageparams" value="&lt;b&gt;PageParams&lt;/b&gt;&lt;br&gt;page (0) / size (20, teto 100) → PageResponse" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="L1"><mxGeometry x="700" y="20" width="240" height="110" as="geometry"/></mxCell><mxCell id="exmappers" value="&lt;b&gt;resource.exception&lt;/b&gt;&lt;br&gt;8 ExceptionMappers → ErrorResponse / ValidationErrorResponse (400, 401, 403, 404, 429)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="L1"><mxGeometry x="430" y="20" width="240" height="110" as="geometry"/></mxCell><mxCell id="services" value="&lt;b&gt;services&lt;/b&gt;&lt;br&gt;regras de negócio por agregado; @Transactional só quando cruza agregados (UserService.register, ComboService.register, OrderService.place…)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L2"><mxGeometry x="160" y="20" width="240" height="170" as="geometry"/></mxCell><mxCell id="dtos" value="&lt;b&gt;requests / responses&lt;/b&gt;&lt;br&gt;XRequest (+ Bean Validation), XResponse, Request/ResponseMapper" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L2"><mxGeometry x="430" y="110" width="240" height="80" as="geometry"/></mxCell><mxCell id="exceptions" value="&lt;b&gt;exceptions&lt;/b&gt;&lt;br&gt;XNotFound, InvalidRequest, Forbidden, Unauthorized, TooManyRequests, UnavailableItems" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L2"><mxGeometry x="430" y="20" width="240" height="80" as="geometry"/></mxCell><mxCell id="ports_app" value="&lt;b&gt;portas da aplicação&lt;/b&gt;&lt;br&gt;CurrentUser · TokenService" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L2"><mxGeometry x="700" y="110" width="240" height="80" as="geometry"/></mxCell><mxCell id="memory" value="&lt;b&gt;estado em memória&lt;/b&gt;&lt;br&gt;AuthenticationCache (30 s) · LoginAttemptLimiter · OrderEventBus (SSE)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L2"><mxGeometry x="700" y="20" width="240" height="80" as="geometry"/></mxCell><mxCell id="perm_resolver" value="&lt;b&gt;PermissionResolver&lt;/b&gt;&lt;br&gt;resolveSession(sub, sid): 1 query: usuário ativo, sessão viva, role e permissões" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L2"><mxGeometry x="970" y="20" width="240" height="80" as="geometry"/></mxCell><mxCell id="time" value="&lt;b&gt;BusinessTime&lt;/b&gt;&lt;br&gt;Clock UTC → fuso do restaurante (America/Sao_Paulo)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L2"><mxGeometry x="970" y="110" width="240" height="80" as="geometry"/></mxCell><mxCell id="models" value="&lt;b&gt;models&lt;/b&gt;&lt;br&gt;records Java puros (Product, Order, User…), sem anotação de framework e sem invariantes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="L3"><mxGeometry x="160" y="20" width="240" height="100" as="geometry"/></mxCell><mxCell id="repo_ports" value="&lt;b&gt;repositories (portas)&lt;/b&gt;&lt;br&gt;19 interfaces: save, remove, getById, getPage… agnósticas de ORM" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="L3"><mxGeometry x="430" y="20" width="240" height="100" as="geometry"/></mxCell><mxCell id="panache" value="&lt;b&gt;repositories Panache&lt;/b&gt;&lt;br&gt;PanacheXRepository implementa a porta + PanacheRepository&amp;lt;XEntity&amp;gt;; @Transactional em save/remove; Sort.by(&quot;id&quot;) nas páginas" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="L4"><mxGeometry x="430" y="20" width="240" height="160" as="geometry"/></mxCell><mxCell id="entities" value="&lt;b&gt;entities + mapper