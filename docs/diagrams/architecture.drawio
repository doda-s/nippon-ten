<mxfile host="drawio" version="26.0.0" pages="2"><diagram name="Camadas" id="layers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;nippon-ten — arquitetura&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Monólito Quarkus 3 / Java 25 em camadas (ports &amp;amp; adapters). Setas cheias = chamada; tracejada com triângulo vazado = implementa a porta.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="60" as="geometry"/></mxCell><mxCell id="front" value="&lt;b&gt;Front do cliente&lt;/b&gt;&lt;br&gt;cardápio, carrinho, checkout,&lt;br&gt;acompanhamento do pedido" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="90" width="240" height="70" as="geometry"/></mxCell><mxCell id="dash" value="&lt;b&gt;Dashboard interno&lt;/b&gt;&lt;br&gt;funcionários: catálogo, pedidos,&lt;br&gt;usuários e roles" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="90" width="240" height="70" as="geometry"/></mxCell><mxCell id="api" value="API nippon-ten (Quarkus 3 · Java 25 · porta 8080)" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=14;collapsible=0;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1280" height="930" as="geometry"/></mxCell><mxCell id="L0" value="Borda HTTP&lt;br&gt;&lt;font style='font-size:10px'&gt;Vert.x, antes do JAX-RS&lt;/font&gt;" style="swimlane;horizontal=0;startSize=130;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;collapsible=0;swimlaneFillColor=#ffffff;fillColor=#f8cecc;str