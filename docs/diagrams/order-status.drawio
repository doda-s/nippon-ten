D" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="170" y="420" width="1160" height="60" as="geometry"/></mxCell><mxCell id="t0" value="POST /orders&lt;br&gt;IN_PERSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-init" target="s-pending"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="55" y="150"/><mxPoint x="530" y="150"/></Array></mxGeometry></mxCell><mxCell id="t-online" value="ONLINE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="s-init" target="s-awaiting"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t-paid" value="pagamento&lt;br&gt;aprovado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="s-awaiting" target="s-pending"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t1" value="funcionário" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="s-pending" target="s-prep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t2" value="funcionário" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="s-prep" target="s-ready"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t3" value="DELIVERY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="s-ready" target="s-ofd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t4" value="funcionário" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="s-ofd" target="s-done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5" value="PICKUP / DINE_IN: funcionário" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-ready" target="s-done"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="110"/><mxPoint x="1490" y="110"/></Array></mxGeometry></mxCell><mxCell id="c-aw" value="vencido (job)&lt;br&gt;ou cliente, visitante" style="edgeStyle=none;html=1;endArrow=block;endSize=8;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.069;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-awaiting" target="s-cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c0" value="cliente, visitante&lt;br&gt;ou funcionário" style="edgeStyle=none;html=1;endArrow=block;endSize=8;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3103;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-pending" target="s-cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1" value="funcionário" style="edgeStyle=none;html=1;endArrow=block;endSize=8;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5172;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-prep" target="s-cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="funcionário" style="edgeStyle=none;html=1;endArrow=block;endSize=8;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7241;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-ready" target="s-cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="funcionário" style="edgeStyle=none;html=1;endArrow=block;endSize=8;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.931;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-ofd" target="s-cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="status-note" value="&lt;b&gt;Fora da máquina de estados&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Pago presencial&lt;/b&gt; (POST /orders/{id}/pay, só IN_PERSON): flag + paid_at, independente do status; gera evento.&lt;br&gt;• &lt;b&gt;Pago online&lt;/b&gt;: só o pagamento aprovado (webhook do Mercado Pago ou job de reconciliação) leva AWAITING_PAYMENT a PENDING; ninguém faz essa transição pela API.&lt;br&gt;• Pedido online sem pagamento aberto é cancelado pelo job 30 min após a criação (cancel_reason = Payment not completed).&lt;br&gt;• Cancelar um pedido pago online estorna antes no Mercado Pago; se o estorno falhar, a resposta é 502 e nada muda.&lt;br&gt;• &lt;b&gt;Editar itens&lt;/b&gt; (PUT /orders/{id}/items): só IN_PERSON, em PENDING ou IN_PREPARATION; reprecifica.&lt;br&gt;• Cancelamento pelo funcionário exige motivo (cancel_reason).&lt;br&gt;• Toda transição grava order_status_history e publica um evento SSE; CHARGED_BACK avisa uma contestação sem mudar o status.&lt;br&gt;• COMPLETED libera um feedback por pedido (nota 1 a 5 + comentário)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="170" y="520" width="1160" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>