><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1" value="funcionário" style="edgeStyle=none;html=1;endArrow=block;endSize=8;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3636;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-prep" target="s-cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="funcionário" style="edgeStyle=none;html=1;endArrow=block;endSize=8;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6364;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-ready" target="s-cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="funcionário" style="edgeStyle=none;html=1;endArrow=block;endSize=8;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9091;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-ofd" target="s-cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="status-note" value="&lt;b&gt;Fora da máquina de estados&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Pago&lt;/b&gt; (POST /orders/{id}/pay): flag + paid_at, independente do status; gera evento.&lt;br&gt;• &lt;b&gt;Editar itens&lt;/b&gt; (PUT /orders/{id}/items): só em PENDING ou IN_PREPARATION; reprecifica.&lt;br&gt;• Cancelamento pelo funcionário exige motivo (cancel_reason).&lt;br&gt;• Toda transição grava order_status_history e publica um evento SSE.&lt;br&gt;• COMPLETED libera um feedback por pedido (nota 1 a 5 + comentário)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="880" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
