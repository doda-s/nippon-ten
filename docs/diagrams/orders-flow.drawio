<mxfile host="drawio" version="26.0.0" pages="1"><diagram name="Fluxo do pedido" id="orders-flow"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-client" value="Cliente / visitante&lt;br&gt;(front)" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=#dae8fc;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1900" height="200" as="geometry"/></mxCell><mxCell id="lane-api" value="API nippon-ten" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="1900" height="200" as="geometry"/></mxCell><mxCell id="lane-staff" value="Funcionário&lt;br&gt;(dashboard, manage_orders)" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=#e1d5e7;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="1900" height="200" as="geometry"/></mxCell><mxCell id="n-start" value="Navega no catálogo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-client"><mxGeometry x="60" y="70" width="140" height="60" as="geometry"/></mxCell><mxCell id="n-cart" value="Monta o carrinho&lt;br&gt;(fica no front)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-client"><mxGeometry x="260" y="65" width="160" height="70" as="geometry"/></mxCell><mxCell id="n-quote" value="&lt;b&gt;POST /orders/quote&lt;/b&gt;&lt;br&gt;recalcula preços, promoção&lt;br&gt;e disponibilidade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-api"><mxGeometry x="460" y="60" width="180" height="80" as="geometry"/></mxCell><mxCell id="n-avail" value="Tudo&lt;br&gt;disponível?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane-api"><mxGeometry x="700" y="55" width="120" height="90" as="geometry"/></mxCell><mxCell id="n-checkout" value="Revisa e faz checkout&lt;br&gt;(atendimento, endereço,&lt;br&gt;pagamento)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-client"><mxGeometry x="880" y="60" width="180" height="80" as="geometry"/></mxCell><mxCell id="n-create" value="&lt;b&gt;POST /orders&lt;/b&gt;&lt;br&gt;recalcula, grava snapshot&lt;br&gt;status PENDING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-api"><mxGeometry x="880" y="60" width="180" height="80" as="geometry"/></mxCell><mxCell id="n-event" value="Evento SSE&lt;br&gt;(após o commit)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane-api"><mxGeometry x="1130" y="65" width="160" height="70" as="geometry"/></mxCell><mxCell id="n-track" value="Acompanha o pedido&lt;br&gt;GET /orders/{id}/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-client"><mxGeometry x="1130" y="65" width="180" height="70" as="geometry"/></mxCell><mxCell id="n-dash" value="Recebe o pedido&lt;br&gt;GET /orders/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane-staff"><mxGeometry x="1130" y="65" width="180" height="70" as="geometry"/></mxCell><mxCell id="n-act" value="Avança status, marca pago,&lt;br&gt;edita itens ou cancela" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane-staff"><mxGeometry x="1380" y="65" width="200" height="70" as="geometry"/></mxCell><mxCell id="n-update" value="&lt;b&gt;POST /orders/{id}/status · pay&lt;br&gt;PUT /orders/{id}/items&lt;/b&gt;&lt;br&gt;+ order_status_history" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-api"><mxGeometry x="1380" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="n-feedback" value="COMPLETED:&lt;br&gt;envia feedback&lt;br&gt;POST /orders/{id}/feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-client"><mxGeometry x="1640" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-start" target="n-cart"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-cart" target="n-quote"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-quote" target="n-avail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f4" value="Não: 400 com os itens indisponíveis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#b85450;" edge="1" parent="1" source="n-avail" target="n-cart"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="40"/><mxPoint x="360" y="40"/></Array></mxGeometry></mxCell><mxCell id="f5" value="Sim: totais" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-avail" target="n-checkout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-checkout" target="n-create"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-create" target="n-event"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f8" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-event" target="n-track"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f9" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-event" target="n-dash"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-dash" target="n-act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-act" target="n-update"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-update" target="n-event"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f13" value="status COMPLETED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-track" target="n-feedback"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-note" value="&lt;b&gt;Regras&lt;/b&gt;&lt;br&gt;• O front nunca define preço: quote e checkout recalculam tudo.&lt;br&gt;• Visitante recebe &lt;i&gt;code&lt;/i&gt; + &lt;i&gt;trackingToken&lt;/i&gt; na criação.&lt;br&gt;• Cliente ou visitante cancela só em PENDING.&lt;br&gt;• No reconnect do SSE, o front recarrega GET /orders/{id}." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="520" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
