<mxfile host="drawio" version="26.0.0" pages="1"><diagram name="Fluxo do pedido" id="orders-flow"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2470" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lane-client" value="Cliente / visitante&lt;br&gt;(front)" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=#dae8fc;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="2420" height="200" as="geometry" /></mxCell><mxCell id="lane-api" value="API nippon-ten" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="2420" height="320" as="geometry" /></mxCell><mxCell id="lane-staff" value="Funcionário&lt;br&gt;(dashboard, manage_orders)" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=#e1d5e7;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="2420" height="200" as="geometry" /></mxCell><mxCell id="lane-mp" value="Mercado Pago&lt;br&gt;(API Orders)" style="swimlane;html=1;startSize=40;horizontal=0;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="2420" height="200" as="geometry" /></mxCell><mxCell id="n-start" value="Navega no catálogo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-client"><mxGeometry x="60" y="70" width="140" height="60" as="geometry" /></mxCell><mxCell id="n-cart" value="Monta o carrinho&lt;br&gt;(fica no front)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-client"><mxGeometry x="260" y="65" width="160" height="70" as="geometry" /></mxCell><mxCell id="n-quote" value="&lt;b&gt;POST /orders/quote&lt;/b&gt;&lt;br&gt;recalcula preços, promoção,&lt;br&gt;disponibilidade e pontos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-api"><mxGeometry x="460" y="60" width="180" height="80" as="geometry" /></mxCell><mxCell id="n-avail" value="Tudo&lt;br&gt;disponível?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane-api"><mxGeometry x="700" y="55" width="120" height="90" as="geometry" /></mxCell><mxCell id="n-checkout" value="Revisa e faz checkout&lt;br&gt;(atendimento, endereço,&lt;br&gt;pagamento, pontos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-client"><mxGeometry x="870" y="60" width="200" height="80" as="geometry" /></mxCell><mxCell id="n-create" value="&lt;b&gt;POST /orders&lt;/b&gt;&lt;br&gt;recalcula, grava snapshot,&lt;br&gt;debita pontos · PENDING ou AWAITING_PAYMENT&lt;br&gt;+ e-mail após o commit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-api"><mxGeometry x="880" y="55" width="180" height="90" as="geometry" /></mxCell><mxCell id="n-event" value="Evento SSE&lt;br&gt;(após o commit)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane-api"><mxGeometry x="1650" y="65" width="160" height="70" as="geometry" /></mxCell><mxCell id="n-track" value="Acompanha o pedido&lt;br&gt;GET /orders/{id}/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-client"><mxGeometry x="1650" y="65" width="180" height="70" as="geometry" /></mxCell><mxCell id="n-dash" value="Recebe o pedido&lt;br&gt;GET /orders/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane-staff"><mxGeometry x="1650" y="65" width="180" height="70" as="geometry" /></mxCell><mxCell id="n-act" value="Avança status, marca pago&lt;br&gt;(presencial), edita itens&lt;br&gt;ou cancela" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane-staff"><mxGeometry x="1900" y="65" width="200" height="70" as="geometry" /></mxCell><mxCell id="n-update" value="&lt;b&gt;POST /orders/{id}/status · pay · cancel&lt;br&gt;PUT /orders/{id}/items&lt;/b&gt;&lt;br&gt;+ order_status_history" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-api"><mxGeometry x="1890" y="60" width="220" height="80" as="geometry" /></mxCell><mxCell id="n-feedback" value="COMPLETED:&lt;br&gt;envia feedback&lt;br&gt;POST /orders/{id}/feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-client"><mxGeometry x="2160" y="60" width="200" height="80" as="geometry" /></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-start" target="n-cart"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-cart" target="n-quote"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-quote" target="n-avail"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f4" value="Não: 400 com os itens indisponíveis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#b85450;" edge="1" parent="1" source="n-avail" target="n-cart"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="40" /><mxPoint x="360" y="40" /></Array></mxGeometry></mxCell><mxCell id="f5" value="Sim: totais" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-avail" target="n-checkout"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-checkout" target="n-create"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f7" value="CREATED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-create" target="n-event"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f8" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-event" target="n-track"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f9" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-event" target="n-dash"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-dash" target="n-act"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-act" target="n-update"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-update" target="n-event"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f13" value="status COMPLETED&lt;br&gt;(credita pontos)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-track" target="n-feedback"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow-note" value="&lt;b&gt;Regras&lt;/b&gt;&lt;br&gt;• O front nunca define preço: quote, checkout e cobrança usam o total calculado pela API.&lt;br&gt;• Visitante informa o e-mail e recebe &lt;i&gt;code&lt;/i&gt; + &lt;i&gt;trackingToken&lt;/i&gt; na criação e no e-mail (link &amp;lt;front&amp;gt;/pedido/&amp;lt;code&amp;gt;#t=&amp;lt;token&amp;gt;).&lt;br&gt;• Pedido ONLINE nasce em AWAITING_PAYMENT; só o pagamento aprovado (webhook ou job) o leva a PENDING.&lt;br&gt;• Cliente ou visitante cancela só em AWAITING_PAYMENT ou PENDING; cancelar pedido pago online estorna antes.&lt;br&gt;• No reconnect do SSE, o front recarrega GET /orders/{id}.&lt;br&gt;• Pontos (cliente com conta): resgate vira desconto no checkout, crédito na conclusão, estorno no cancelamento (ver points.md)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="760" height="140" as="geometry" /></mxCell><mxCell id="n-pay" value="&lt;b&gt;Paga online&lt;/b&gt;&lt;br&gt;Pix: mostra o QR code&lt;br&gt;Cartão: Card Payment Brick&lt;br&gt;(token, só a public key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-client"><mxGeometry x="1130" y="55" width="200" height="90" as="geometry" /></mxCell><mxCell id="n-email" value="Recebe o e-mail (código + link)&lt;br&gt;e abre a página do pedido&lt;br&gt;GET /orders/by-code/{code}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-client"><mxGeometry x="1380" y="55" width="210" height="90" as="geometry" /></mxCell><mxCell id="n-payment" value="&lt;b&gt;POST /orders/{id}/payments&lt;/b&gt;&lt;br&gt;cobra o total do pedido&lt;br&gt;(X-Idempotency-Key)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-api"><mxGeometry x="1130" y="200" width="200" height="80" as="geometry" /></mxCell><mxCell id="n-webhook" value="&lt;b&gt;POST /payments/webhooks/&lt;br&gt;mercadopago&lt;/b&gt;&lt;br&gt;confere a assinatura e&lt;br&gt;busca a order no Mercado Pago" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-api"><mxGeometry x="1380" y="195" width="210" height="90" as="geometry" /></mxCell><mxCell id="n-job" value="&lt;b&gt;Job de reconciliação (60 s)&lt;/b&gt;&lt;br&gt;vence Pix, recupera aprovação&lt;br&gt;perdida, cancela pedido&lt;br&gt;abandonado, refaz estorno" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane-api"><mxGeometry x="600" y="195" width="220" height="90" as="geometry" /></mxCell><mxCell id="n-mp-charge" value="Cria a order (/v1/orders)&lt;br&gt;Pix: QR, vence em 30 min&lt;br&gt;Cartão: aprova, recusa&lt;br&gt;ou deixa em análise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-mp"><mxGeometry x="1130" y="55" width="200" height="90" as="geometry" /></mxCell><mxCell id="n-mp-notify" value="Notifica a mudança&lt;br&gt;(type=order, data.id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-mp"><mxGeometry x="1380" y="65" width="210" height="70" as="geometry" /></mxCell><mxCell id="n-mp-refund" value="Cancela a cobrança aberta&lt;br&gt;ou estorna a aprovada&lt;br&gt;(/cancel · /refund)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-mp"><mxGeometry x="2160" y="60" width="210" height="80" as="geometry" /></mxCell><mxCell id="p1" value="ONLINE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-create" target="n-pay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="293" /><mxPoint x="1120" y="120" /></Array></mxGeometry></mxCell><mxCell id="p2" value="PIX ou CARD + token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-pay" target="n-payment"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3" value="POST /v1/orders" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-payment" target="n-mp-charge"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-mp-charge" target="n-mp-notify"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-mp-notify" target="n-webhook"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6" value="aprovado: PAID +&lt;br&gt;STATUS_CHANGED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n-webhook" target="n-event"><mxGeometry relative="1" as="geometry" x="-0.55"><Array as="points"><mxPoint x="1710" y="460" /></Array></mxGeometry></mxCell><mxCell id="p7" value="aprova, vence ou cancela" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-job" target="n-event"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="525" /><mxPoint x="1770" y="525" /></Array></mxGeometry></mxCell><mxCell id="p8" value="cancelamento online" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-update" target="n-mp-refund"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2285" y="320" /></Array></mxGeometry></mxCell><mxCell id="p9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="n-email" target="n-track"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-create" target="n-email"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="347" /><mxPoint x="1360" y="190" /><mxPoint x="1505" y="190" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>