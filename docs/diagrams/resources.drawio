tems" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;spacingLeft=8;overflow=hidden;" vertex="1" parent="res-OrderResource"><mxGeometry x="0" y="250" width="430" height="20" as="geometry"/></mxCell><mxCell id="res-OrderResource-s10" value="MANAGE_ORDERS" style="rounded=1;arcSize=40;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=none;fontColor=#9a6700;" vertex="1" parent="res-OrderResource"><mxGeometry x="435" y="252" width="138" height="16" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Acesso&lt;/b&gt;&lt;br&gt;&lt;font color='#1a7f37'&gt;■&lt;/font&gt; &lt;b&gt;público&lt;/b&gt; — @PermitAll&lt;br&gt;&lt;font color='#0b5cad'&gt;■&lt;/font&gt; &lt;b&gt;autenticado&lt;/b&gt; — @Authenticated; regra &quot;o próprio usuário ou MANAGE_USERS&quot; fica no Service (CurrentUser.requireSelfOr)&lt;br&gt;&lt;font color='#9a6700'&gt;■&lt;/font&gt; &lt;b&gt;MANAGE_X / SUPER_ADMIN&lt;/b&gt; — @RolesAllowed(Permissions.X)&lt;br&gt;&lt;br&gt;Endpoint sem anotação é negado (deny-unannotated-endpoints). As rotas públicas de um pedido (/orders/{id}, /events, /cancel, /feedback) exigem o tracking token no header, ser o cliente dono ou ter MANAGE_ORDERS — checado em OrderService.requireViewer." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1850" y="702" width="580" height="200" as="geometry"/></mxCell><mxCell id="res-UserResource-r14" value="&lt;b&gt;&lt;font color='#1a7f37'&gt;GET&lt;/font&gt;&lt;/b&gt;&amp;nbsp; /users/{userId}/points" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;spacingLeft=8;overflow=hidden;" vertex="1" parent="res-UserResource"><mxGeometry x="0" y="330" width="430" height="20" as="geometry"/></mxCell><mxCell id="res-UserResource-s14" value="autenticado" style="rounded=1;arcSize=40;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=none;fontColor=#0b5cad;" vertex="1" parent="res-UserResource"><mxGeometry x="435" y="332" width="138" height="16" as="geometry"/></mxCell><mxCell id="res-UserResource-r15" value="&lt;b&gt;&lt;font color='#1a7f37'&gt;GET&lt;/font&gt;&lt;/b&gt;&amp;nbsp; /users/{userId}/points/transactions" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;spacingLeft=8;overflow=hidden;" vertex="1" parent="res-UserResource"><mxGeometry x="0" y="350" width="430" height="20" as="geometry"/></mxCell><mxCell id="res-UserResource-s15" value="autenticado" style="rounded=1;arcSize=40;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=none;fontColor=#0b5cad;" vertex="1" parent="res-UserResource"><mxGeometry x="435" y="352" width="138" height="16" as="geometry"/></mxCell><mxCell id="res-UserResource-r16" value="&lt;b&gt;&lt;font color='#0b5cad'&gt;POST&lt;/font&gt;&lt;/b&gt;&amp;nbsp; /users/{userId}/points/adjustments" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;spacingLeft=8;overflow=hidden;" vertex="1" parent="res-UserResource"><mxGeometry x="0" y="370" width="430" height="20" as="geometry"/></mxCell><mxCell id="res-UserResource-s16" value="MANAGE_POINTS" style="rounded=1;arcSize=40;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=none;fontColor=#9a6700;" vertex="1" parent="res-UserResource"><mxGeometry x="435" y="372" width="138" height="16" as="geometry"/></mxCell><mxCell id="res-PointsResource" value="PointsResource&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal' color='#555555'&gt;/points/settings&lt;/font&gt;" style="swimlane;startSize=46;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;collapsible=0;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="630" y="778" width="580" height="114" as="geometry"/></mxCell><mxCell id="res-PointsResource-r0" value="&lt;b&gt;&lt;font color='#1a7f37'&gt;GET&lt;/font&gt;&lt;/b&gt;&amp;nbsp; /points/settings" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;spacingLeft=8;overflow=hidd